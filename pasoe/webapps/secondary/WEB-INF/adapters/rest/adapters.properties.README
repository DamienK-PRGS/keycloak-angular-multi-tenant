# -------------------- adapters.properties.README -----------------------
#
# Property File for the Pacific Application Server for OpenEdge
#
# This file provides detailed descriptions of the properties that can be
# defined in the Pacific AppServer for OpenEdge.
#
##########################################################################

# Input Parsing Constraints
# These properties limit excessive memory usage and processing time
# by restricting various aspects of JSON input parsing.

## maxTokenLength
# Defines the maximum length (in characters) for a single numeric token.
# This applies to both integer and floating-point numbers.
# Default: 1000
maxTokenLength=1000

## maxStringLength
# Specifies the maximum allowed length for string values in JSON.
# This helps prevent excessive memory allocation due to large input strings.
# Default: 20,000,000 (20 million characters)
maxStringLength=20000000

## maxNestingDepth
# Sets the maximum depth for nested JSON structures.
# Prevents excessive recursion and stack overflows.
# Default: 1000 levels
maxNestingDepth=1000

## maxPropertyNameLength
# Defines the maximum length for property names in JSON objects.
# Helps prevent inefficient memory allocation and parsing delays.
# Default: 50,000 characters
maxPropertyNameLength=50000

## maxDocumentLength
# Defines the maximum size of a JSON document.
# Default: -1 (unlimited)
maxDocumentLength=-1

# Output Generation Constraints
# These properties control JSON output generation limits.

## maxOutputNestingDepth
# Defines the maximum nesting depth allowed in JSON output.
# This prevents excessive depth that can impact performance.
# Default: 1000 levels
maxOutputNestingDepth=1000

##########################################################################