<included>

  <appender name="SIFT-${CONTEXT_NAME}-OEMGR" class="ch.qos.logback.classic.sift.SiftingAppender">
    <discriminator class="com.progress.appserv.services.logging.ContextDiscriminator">
      <defaultValue>unknown</defaultValue>
    </discriminator>
    <sift>
      <appender name="FILE-${contextName}-OEMGR" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <append>true</append> 
        <prudent>true</prudent>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
          <fileNamePattern>${catalina.logging.folder}/${psc.as.logging.oeman.fileName}</fileNamePattern> 
          <maxHistory>${psc.as.logging.maxhistory}</maxHistory>
        </rollingPolicy>
        <encoder>
          <pattern>${psc.as.logging.oeman.pattern}</pattern>
        </encoder>
      </appender>
    </sift>
  </appender>

    <!--Turn On OEManager Loggers here.-->
    <!--
    <logger name="com.progress.appserv.manager.admin" level="TRACE"/>
    -->
    <root level="${psc.as.logging.oeman.level}">
        <appender-ref ref="SIFT-${CONTEXT_NAME}-OEMGR" /> 
    </root>

</included>

